message FixedItem {
   1: required fl32 x;
   2: required fl32 y;
}

message VarItem {
   1: optional string name;
   2: required int64 id;
}

message RootPayload {
   1: optional string header;
   2: packed FixedItem fixed_array;
   3: repeated VarItem var_array;
}

message FixedVector {
   1: required fl32[2] coords;
   2: required int16[2][3] grid;
}

message FixedRow {
   1: required FixedVector[2] vectors;
}

message FixedBoard {
   1: required FixedRow[2] rows;
   2: packed FixedRow packed_rows;
}

message FixedRowBatch {
   1: packed FixedRow rows;
}

message AnonymousEnvelope {
   1: required struct {
      1: required int32 code;
      2: optional struct {
         1: required string text;
      } detail;
   } metadata;
   2: repeated struct {
      1: required fl32 x;
      2: required fl32 y;
   } points;
}
