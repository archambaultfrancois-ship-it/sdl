#!/usr/bin/env python3
"""Inspect, validate, transform, convert and replay SDL2 MCAP/PCAPNG recordings."""

import argparse
from decimal import Decimal, DecimalException, localcontext
import importlib
import itertools
import json
import math
from pathlib import Path
import sys
import textwrap

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / 'runtime/python'))

try:
   from sdl_recording import RecordingError, RecordingReader, convert_recording, replay
except ModuleNotFoundError as error:
   if error.name == 'mcap':
      sys.exit('Recording requires mcap: python3 -m pip install --no-deps -r tools/recording/requirements.txt')
   raise
from sdl_runtime import Complex32, Complex64, SdlDynamicEnum, SdlDynamicMessage, display


def _json_value(value, limit, depth=0):
   if depth >= 16:
      return {'summary': 'maximum display depth reached'}
   if isinstance(value, SdlDynamicMessage):
      return {'type': value.type_name, 'fields': {
         k: _json_value(v, limit, depth + 1) for k, v in value.fields.items()}}
   if isinstance(value, SdlDynamicEnum):
      return {'type': value.type_name, 'value': value.value, 'name': value.name}
   if isinstance(value, (Complex32, Complex64)):
      return {'real': _json_value(value.real, limit, depth + 1),
              'imag': _json_value(value.imag, limit, depth + 1)}
   if isinstance(value, (list, tuple)):
      if limit is not None and len(value) > limit:
         return {'length': len(value), 'preview': [
            _json_value(v, limit, depth + 1) for v in value[:limit]]}
      return [_json_value(v, limit, depth + 1) for v in value]
   if isinstance(value, float) and not math.isfinite(value):
      return str(value)
   if isinstance(value, str) and limit is not None and len(value) > 1024:
      return {'length': len(value), 'preview': value[:1024]}
   return value


def _duration(value):
   scales = {'ns': 1, 'us': 1000, 'ms': 1000000, 's': 1000000000}
   for suffix, scale in scales.items():
      if value.endswith(suffix):
         try:
            duration = Decimal(value[:-len(suffix)])
            with localcontext() as context:
               context.prec = max(28, len(duration.as_tuple().digits) + 10)
               ns = duration * scale
               if ns.is_finite() and 0 <= ns < 1 << 64 and ns == ns.to_integral_value():
                  return int(ns)
         except DecimalException:
            pass
         break
   raise argparse.ArgumentTypeError('use a nonnegative duration with ns, us, ms or s (e.g. 1.5s)')


def _time_bound(value):
   relative = value.startswith('+')
   amount = value[1:] if relative else value
   if amount.startswith(('+', '-')):
      raise argparse.ArgumentTypeError('use an absolute timestamp (1s) or a nonnegative offset (+1s)')
   return _duration(amount), relative


def _time_selection(reader, start, end, duration):
   needs_origin = any(bound is not None and bound[1] for bound in (start, end))
   needs_origin = needs_origin or (duration is not None and start is None)
   origin = (reader.info()['start_time_ns'] or 0) if needs_origin else 0
   start = None if start is None else start[0] + (origin if start[1] else 0)
   end = None if end is None else end[0] + (origin if end[1] else 0)
   if duration is not None:
      start = origin if start is None else start
      end = start + duration
   if any(bound is not None and bound >= 1 << 64 for bound in (start, end)):
      raise RecordingError('resolved time bound is outside uint64 nanoseconds')
   if start is not None and end is not None and end < start:
      raise RecordingError('--to must be at or after --from')
   return start, end


def _positive(value):
   result = int(value)
   if result < 1:
      raise argparse.ArgumentTypeError('must be positive')
   return result


def _nonnegative(value):
   result = int(value)
   if result < 0:
      raise argparse.ArgumentTypeError('must be nonnegative')
   return result


def _emit(value):
   print(json.dumps(value, ensure_ascii=False, allow_nan=False))


def _inspect(record, full=False):
   return {'topic': record.channel.topic, 'channel_id': record.channel.id,
      'schema_id': record.channel.schema_id, 'root_type': record.channel.root_type,
      'log_time_ns': record.log_time_ns, 'publish_time_ns': record.publish_time_ns,
      'sequence': record.sequence, 'payload_bytes': len(record.payload),
      'message': _json_value(record.decode(), None if full else 8)}


def _text_value(value, limit):
   if isinstance(value, str):
      if limit is not None and len(value) > 1024:
         return json.dumps(value[:1024], ensure_ascii=False) + ' ... (length=%d)' % len(value)
      return json.dumps(value, ensure_ascii=False)
   if isinstance(value, SdlDynamicEnum):
      return '%s (%d)' % (value.name, value.value) if value.name is not None else str(value.value)
   if isinstance(value, (Complex32, Complex64)):
      return '(%s, %s)' % (value.real, value.imag)
   if value is None:
      return 'null'
   if isinstance(value, bool):
      return 'true' if value else 'false'
   return str(value)


def _text_rows(record, full):
   limit = None if full else 8
   for name, type_name, value in (
         ('topic', 'string', record.channel.topic),
         ('channel_id', 'uint16', record.channel.id),
         ('schema_id', 'uint16', record.channel.schema_id),
         ('root_type', 'string', record.channel.root_type),
         ('log_time_ns', 'uint64', record.log_time_ns),
         ('publish_time_ns', 'uint64', record.publish_time_ns),
         ('sequence', 'uint32', record.sequence),
         ('payload_bytes', 'uint64', len(record.payload))):
      yield '@' + name, type_name, _text_value(value, limit)

   def visit(path, value, type_name, dimensions=(), modifier='required', depth=0):
      label = (modifier + ' ' if modifier != 'required' else '') + type_name
      label += ''.join('[%d]' % size for size in dimensions)
      if depth >= 16:
         yield path, label, 'maximum display depth reached'
      elif isinstance(value, SdlDynamicMessage):
         if not value.fields:
            yield path, label, '{}'
         for field in record.channel.context.messages[value.type_name]:
            name = field['name']
            yield from visit(path + '.' + name if path else name, value.fields[name],
               field['type'], field['dimensions'], field['modifier'], depth + 1)
      elif isinstance(value, (list, tuple)):
         yield path, label, 'length=%d' % len(value)
         end = len(value) if limit is None else min(len(value), limit)
         child_dimensions = dimensions if modifier in ('packed', 'repeated') else dimensions[1:]
         for i in range(end):
            yield from visit('%s[%d]' % (path, i), value[i], type_name,
               child_dimensions, depth=depth + 1)
         if end < len(value):
            yield path + '[...]', label, '%d more elements (use --full)' % (len(value) - end)
      else:
         yield path, label, _text_value(value, limit)

   message = record.decode()
   yield from visit('', message, message.type_name)


def _inspect_table(record, number, full):
   _print_table(list(_text_rows(record, full)), 'Record %d' % number)


def _print_table(rows, title):
   rows = [('FIELD', 'TYPE', 'VALUE')] + rows
   widths = [min(cap, max(len(row[i]) for row in rows))
      for i, cap in enumerate((48, 32, 80))]
   print(title)
   for row_index, row in enumerate(rows):
      cells = [textwrap.wrap(cell, width=width, replace_whitespace=False,
         drop_whitespace=False, break_on_hyphens=False) or ['']
         for cell, width in zip(row, widths)]
      for line in itertools.zip_longest(*cells, fillvalue=''):
         print(' | '.join(cell.ljust(width) for cell, width in zip(line, widths)).rstrip())
      if row_index == 0:
         print('-+-'.join('-' * width for width in widths))
   print()


def _inspect_summary(summary, format, indent_width):
   if format == 'json':
      _emit(summary)
   elif format == 'text':
      fields = dict(summary)
      fields['message_count_by_topic'] = SdlDynamicMessage('TopicCounts',
         summary['message_count_by_topic'])
      print(display(SdlDynamicMessage('RecordingSummary', fields), indent_width), end='')
   else:
      rows = []
      for name, value in summary.items():
         if name == 'message_count_by_topic':
            if not value:
               rows.append((name, 'map<string, uint64>', '{}'))
            for topic, count in value.items():
               rows.append((name + '[' + _text_value(topic, None) + ']', 'uint64', str(count)))
         else:
            type_name = 'fl64' if name == 'duration_seconds' else 'bool' if isinstance(value, bool) else 'uint64'
            rows.append((name, type_name,
               _text_value(value, None)))
      _print_table(rows, 'Recording summary')


def _inspect_text(record, full, indent_width):
   message = SdlDynamicMessage('RecordingRecord', {
      'topic': record.channel.topic,
      'channel_id': record.channel.id,
      'schema_id': record.channel.schema_id,
      'log_time_ns': record.log_time_ns,
      'publish_time_ns': record.publish_time_ns,
      'sequence': record.sequence,
      'payload_bytes': len(record.payload),
      'message': record.decode(),
   })
   print(display(message, indent_width, max_items=None if full else 8), end='')


def main(argv=None):
   parser = argparse.ArgumentParser(description=__doc__)
   sub = parser.add_subparsers(dest='command', required=True)
   for name in ('info', 'validate', 'inspect', 'replay'):
      command = sub.add_parser(name)
      command.add_argument('file')
      if name in ('inspect', 'replay'):
         command.add_argument('-t', '--topic', action='append', help='repeat to select multiple topics')
         command.add_argument('-b', '--from', dest='start', type=_time_bound, metavar='TIME',
            help='inclusive log-time bound: absolute timestamp or +offset from recording start (ns/us/ms/s)')
         stop = command.add_mutually_exclusive_group()
         stop.add_argument('-e', '--to', dest='end', type=_time_bound, metavar='TIME',
            help='exclusive log-time bound: absolute timestamp or +offset from recording start (ns/us/ms/s)')
         stop.add_argument('-d', '--duration', type=_duration, metavar='DURATION',
            help='set exclusive end to start + duration (ns/us/ms/s); without --from, start at recording beginning')
      if name == 'inspect':
         command.add_argument('-c', '--check', action='store_true',
            help='validate selected message bodies and report a summary instead of messages')
         command.add_argument('-s', '--summary', action='store_true',
            help='report counts by topic, log-time bounds and duration in seconds instead of messages; combine with --check to validate bodies')
         command.add_argument('-n', '--limit', type=_positive,
            help='maximum number of messages to display (default: no limit; ignored with --check/--summary)')
         command.add_argument('-a', '--full', action='store_true', help='print entire arrays and strings')
         command.add_argument('-f', '--format', choices=('json', 'text', 'table'), default='json',
            help='json: objects (default); text: SDL display; table: field/type/value columns')
         command.add_argument('-i', '--indent-width', type=_nonnegative, default=3,
            help='spaces per level for --format text (default: 3)')
      if name == 'replay':
         command.add_argument('--speed', type=float, default=1.0, help='0: no wait; 1: recorded pace')
         command.add_argument('--consumer', required=True, help='Python module:function receiving a RecordingRecord')
   convert = sub.add_parser('convert', help='preserve SDL records in another container')
   convert.add_argument('file')
   convert.add_argument('output')
   convert.add_argument('--format', choices=('mcap', 'pcapng'), default='pcapng',
      help='output container (default: pcapng)')
   convert.add_argument('--overwrite', action='store_true')
   from sdl_recording_transform import parse_duration, parse_size, time_bound
   transform = sub.add_parser('transform', help='filter, concatenate and split recordings without changing their format')
   transform.add_argument('files', nargs='+', help='input files in the desired order; shell globs are supported')
   transform.add_argument('-o', '--output', required=True,
      help='output path/pattern: {index:04d}, {source}, {format}; parent directory must exist')
   transform.add_argument('--concat', action='store_true', help='assemble all inputs into one logical stream')
   transform.add_argument('--timeline', choices=('preserve', 'append'), default='preserve')
   transform.add_argument('--gap', type=parse_duration, default=0, help='extra gap between appended inputs (seconds or ns/us/ms/s/m/h)')
   transform.add_argument('-t', '--topic', action='append', default=[], help='topic glob; repeat for alternatives')
   transform.add_argument('--type', dest='types', action='append', default=[], help='root type glob; repeat for alternatives')
   transform.add_argument('--filter', action='append', default=[], help='SDL content predicate; repeated predicates are ANDed')
   transform.add_argument('--from', dest='start', type=time_bound, help='inclusive original log time; +offset from each input start')
   stop = transform.add_mutually_exclusive_group()
   stop.add_argument('--to', dest='end', type=time_bound, help='exclusive original log time; +offset from each input start')
   stop.add_argument('--duration', type=parse_duration, help='selected duration from --from or each input start')
   transform.add_argument('--split-duration', type=parse_duration, help='maximum log-time span per output (e.g. 10m)')
   transform.add_argument('--split-size', type=parse_size, help='maximum complete output bytes (e.g. 100MB)')
   transform.add_argument('--split-messages', type=_positive, help='maximum messages per output')
   transform.add_argument('--dry-run', action='store_true', help='validate and calculate exact output counts/sizes without creating files')
   transform.add_argument('--overwrite', action='store_true', help='replace existing outputs only after successful staging')
   args = parser.parse_args(argv)
   try:
      if args.command == 'transform':
         from sdl_recording import transform_recordings
         _emit(transform_recordings(args.files, args.output, concat=args.concat, timeline=args.timeline,
            gap_ns=args.gap, topics=args.topic, types=args.types, filters=args.filter,
            start=args.start, end=args.end, duration_ns=args.duration,
            split_duration_ns=args.split_duration, split_size=args.split_size,
            split_messages=args.split_messages, dry_run=args.dry_run, overwrite=args.overwrite))
         return 0
      reader = RecordingReader(args.file)
      if args.command == 'convert':
         count = convert_recording(args.file, args.output, format=args.format, overwrite=args.overwrite)
         _emit({'format': args.format, 'message_count': count, 'output': args.output})
      elif args.command == 'info':
         _emit(reader.info())
      elif args.command == 'validate':
         _emit({'valid': True, **reader.validate_summary()})
      else:
         start, end = _time_selection(reader, args.start, args.end, args.duration)
         selection = dict(topics=args.topic, start_time_ns=start, end_time_ns=end)
         if args.command == 'inspect':
            if args.check or args.summary:
               summary = reader.summary(**selection, check=args.check)
               if args.check:
                  summary = {'valid': True, **summary}
               _inspect_summary(summary, args.format, args.indent_width)
               return 0
            records = reader.iter_records(**selection)
            try:
               for number, record in enumerate(itertools.islice(records, args.limit), 1):
                  if args.format == 'text':
                     _inspect_text(record, args.full, args.indent_width)
                  elif args.format == 'table':
                     _inspect_table(record, number, args.full)
                  else:
                     _emit(_inspect(record, args.full))
            finally:
               records.close()
         else:
            if not math.isfinite(args.speed) or args.speed < 0:
               raise RecordingError('--speed must be finite and nonnegative')
            # Complete validation before delivering anything to application code.
            reader.validate()
            previous = None
            if args.speed:
               for record in reader.iter_records(**selection):
                  if previous is not None and record.log_time_ns < previous:
                     raise RecordingError('log time moved backwards; use --speed 0 for file-order replay')
                  previous = record.log_time_ns
            module, separator, function = args.consumer.partition(':')
            if not separator or not module or not function:
               raise RecordingError('--consumer must be module:function')
            consumer = getattr(importlib.import_module(module), function)
            if not callable(consumer):
               raise RecordingError('consumer is not callable')
            count = replay(reader.iter_records(**selection), consumer, speed=args.speed)
            print('Replayed %d messages' % count, file=sys.stderr)
      return 0
   except (RecordingError, OSError, ValueError, ImportError, AttributeError) as error:
      print('sdl-recording: ' + str(error), file=sys.stderr)
      return 1
   except KeyboardInterrupt:
      print('sdl-recording: interrupted', file=sys.stderr)
      return 130


if __name__ == '__main__':
   sys.exit(main())
