message BenchSmall {
  1: required bool active;
  2: required int32 sequence;
  3: required int16 code;
}
message BenchOptionals {
  1: optional int32 a;
  2: optional int32 b;
  3: optional int32 c;
  4: optional int32 d;
  5: optional int32 e;
  6: optional int32 f;
  7: optional int32 g;
  8: optional int32 h;
}
message BenchEntry {
  1: optional string label;
  2: required int64 number;
}
message BenchVariable {
  1: required string header;
  2: repeated BenchEntry entries;
}
message BenchVector {
  1: required fl32[3] values;
}
message BenchPose {
  1: required BenchVector position;
  2: required fl32[4] rotation;
}
message BenchRecord {
  1: required int32 id;
  2: required BenchPose pose;
  3: required fl32[2] measures;
}
message BenchRecordBatch {
  1: packed BenchRecord records;
}
