nnect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1260" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="item0" value="SDL DESIGN / DYNAMIC / 08" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#64748b;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1520" height="25" as="geometry" /></mxCell><mxCell id="item1" value="Catalogue resolution in the TCP pub/sub demo" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=30;fontColor=#16324f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1520" height="50" as="geometry" /></mxCell><mxCell id="item2" value="Python sample: immutable catalogues, one topic contract and a bounded in-memory history." style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=16;fontColor=#526578;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="116" width="1520" height="40" as="geometry" /></mxCell><mxCell id="footer" value="&lt;b&gt;Design notes&lt;/b&gt;&lt;br&gt;&lt;br&gt;RPC uses length-prefixed JSON; payload envelopes are Base64. S2PS/2 carries catalogue ID + unchanged SDL2 bytes, not the catalogue itself.&lt;br&gt;Cache hits skip resolution. Unknown catalogues, collisions and history gaps return errors. The sample has one topic, 256 history entries, no restart persistence or delivery guarantees." style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=18;fillColor=#fff9e9;strokeColor=#d1bb7e;strokeWidth=1.5;fontSize=15;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="1520" height="130" as="geometry" /></mxCell><mxCell id="actor0" value