rflow=hidden;fontFamily=Arial;text;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#243b53;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1192" y="941" width="290" height="42" as="geometry" /></mxCell><mxCell id="item43" value="" style="edgeStyle=none;rounded=0;html=0;strokeWidth=2;strokeColor=#60758b;endArrow=open;endFill=0;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="1020" as="sourcePoint" /><mxPoint x="1440" y="1020" as="targetPoint" /></mxGeometry></mxCell><mxCell id="item44" value="local typed value / error" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;text;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#243b53;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1173.0" y="990.0" width="224" height="25" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="05-filtering" name="05 Predicate preparation and evaluation"><mxGraphModel dx="1600" dy="1260" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1260" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="item0" value="SDL DESIGN / DYNAMIC / 05" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#64748b;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1520" height="25" as="geometry" /></mxCell><mxCell id="item1" value="Predicate preparation and evaluation" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=30;fontColor=#16324f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1520" height="50" as="geometry" /></mxCell><mxCell id="item2" value="The application evaluates either a message object or encoded SDL2 bytes." style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=16;fontColor=#526578;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="116" width="1520" height="40" as="geometry" /></mxCell><mxCell id="footer" value="&lt;b&gt;Design notes&lt;/b&gt;&lt;br&gt;&lt;br&gt;Wire filtering validates the root and accessed values; use the full decoder to validate untouched variable fields. Quantized wire values may differ from object values.&lt;br&gt;Python encode_filtered / decode_filtered return codec output plus status; they still run the codec. The application chooses which statuses to retain." style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=18;fillColor=#fff9e9;strokeColor=#d1bb7e;strokeWidth=1.5;fontSize=15;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="1520" height="130" as="geometry" /></mxCell><mxCell id="actor0" value="&lt;b&gt;Application&lt;/b&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=18;fillColor=#edf0f4;strokeColor=#65758b;strokeWidth=1.5;fontSize=16;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry x="40" y="175" width="240" height="60" as="geometry" /></mxCell><mxCell id="item5" value="" style="edgeStyle=none;rounded=0;html=0;strokeWidth=2;strokeColor=#b3c0cf;endArrow=open;endFill=0;endArrow=none;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="235" as="sourcePoint" /><mxPoint x="160" y="1080" as="targetPoint" /></mxGeometry></mxCell><mxCell id="actor1" value="&lt;b&gt;Language adapter&lt;/b&gt;" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=18;fillColor=#edf0f4;strokeColor=#65758b;strokeWi