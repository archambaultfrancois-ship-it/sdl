ext is deduplicated within a file." style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=18;fillColor=#fff9e9;strokeColor=#d1bb7e;strokeWidth=1.5;fontSize=15;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="1520" height="130" as="geometry" /></mxCell><mxCell id="local" value="&lt;b&gt;Local type metadata&lt;/b&gt;&lt;br&gt;&lt;br&gt;Logical type names&lt;br&gt;Fields, defaults, language representation&lt;br&gt;C descriptors / Rust TypeInfo / classes" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=18;fillColor=#f0eafa;strokeColor=#8060ae;strokeWidth=1.5;fontSize=15;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="390" height="125" as="geometry" /></mxCell><mxCell id="cat" value="&lt;b&gt;SDL2 catalogue&lt;/b&gt;&lt;br&gt;&lt;br&gt;Exact canonical UTF-8 text&lt;br&gt;Message declarations and enums&lt;br&gt;Wire representation metadata" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=18;fillColor=#fff2d6;strokeColor=#bc8933;strokeWidth=1.5;fontSize=16;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry x="600" y="220" width="380" height="125" as="geometry" /></mxCell><mxCell id="message" value="&lt;b&gt;Message declaration&lt;/b&gt;&lt;br&gt;&lt;br&gt;Logical name&lt;br&gt;Catalogue-relative message ID&lt;br&gt;Ordered fields" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=18;fillColor=#fff2d6;strokeColor=#bc8933;strokeWidth=1.5;fontSize=16;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry x="1140" y="220" width="400" height="125" as="geometry" /></mxCell><mxCell id="field" value="&lt;b&gt;Field declaration&lt;/b&gt;&lt;br&gt;&lt;br&gt;Stable field ID + name + logical type&lt;br&gt;Cardinality and fixed dimensions&lt;br&gt;bits /