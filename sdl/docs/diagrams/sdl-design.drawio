<mxfile host="app.diagrams.net" type="device" compressed="false" pages="8"><diagram id="01-architecture" name="01 Architecture overview"><mxGraphModel dx="1600" dy="1260" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1260" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="item0" value="SDL DESIGN / STATIC / 01" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#64748b;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1520" height="25" as="geometry" /></mxCell><mxCell id="item1" value="Architecture overview" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=30;fontColor=#16324f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1520" height="50" as="geometry" /></mxCell><mxCell id="item2" value="Build-time generation, runtime message exchange and associated services." style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=16;fontColor=#526578;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="116" width="1520" height="40" as="geometry" /></mxCell><mxCell id="footer" value="&lt;b&gt;Design notes&lt;/b&gt;&lt;br&gt;&lt;br&gt;Solid arrows show data or calls; dashed arrows show use of catalogue metadata. Colours: purple = generated code; blue = codec; green = service; amber = data; grey = integration.&lt;br&gt;Each language owns its message API. Transport framing, catalogue delivery and application decisions remain with the application." style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=18;fillColor=#fff9e9;strokeColor=#d1bb7e;strokeWidth=1.5;fontSize=15;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="1520" height="130" as="geometry" /></mxCell><mxCell id="schema" value="&lt;b&gt;SDL schemas&lt;/b&gt;&lt;br&gt;&lt;br&gt;.sdl files&lt;br&gt;Messages, enums, packages&lt;br&gt;Constants, aliases, wire options" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=18;fillColor=#fff2d6;strokeColor=#bc8933;strokeWidth=1.5;fontSize=16;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="310" height="130" as="geometry" /></mxCell><mxCell id="generator" value="&lt;b&gt;Python generator&lt;/b&gt;&lt;br&gt;&lt;br&gt;Parse and resolve declarations&lt;br&gt;Validate types and dimensions&lt;br&gt;Emit selected language backends" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=18;fillColor=#f0eafa;strokeColor=#8060ae;strokeWidth=1.5;fontSize=16;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry x="600" y="200" width="380" height="130" as="geometry" /></mxCell><mxCell id="bindings" value="&lt;b&gt;Generated bindings&lt;/b&gt;&lt;br&gt;&lt;br&gt;C / Rust / Python / Java / Ada / MATLAB&lt;br&gt;Local types and schema metadata&lt;br&gt;Specialized codecs where supported" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=18;fillColor=#f0eafa;strokeColor=#8060ae;strokeWidth=1.5;fontSize=15;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry x="1200" y="200" width="340" height="130" as="geometry" /></mxCell><mxCell id="item7" value="" style="edgeStyle=none;rounded=0;html=0;strokeWidth=2;strokeColor=#60758b;endArrow=block;endFill=1;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="schema" target="generator"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="265.0" as="sourcePoint" /><mxPoint x="600" y="265.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="item8" value="generate" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;text;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#243b53;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="435.0" y="235.0" width="100" height="25" as="geometry" /></mxCell><mxCell id="item9" value="" style="edgeStyle=none;rounded=0;html=0;strokeWidth=2;strokeColor=#60758b;endArrow=block;endFill=1;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="generator" target="bindings"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="265.0" as="sourcePoint" /><mxPoint x="1200" y="265.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="item10" value="types + metadata" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;text;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#243b53;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1014.0" y="235.0" width="152" height="25" as="geometry" /></mxCell><mxCell id="application" value="&lt;b&gt;Application&lt;/b&gt;&lt;br&gt;&lt;br&gt;Creates and consumes values&lt;br&gt;Chooses filters and channels&lt;br&gt;Manages errors and lifetimes" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=18;fillColor=#edf0f4;strokeColor=#65758b;strokeWidth=1.5;fontSize=16;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry x="60" y="510" width="310" height="150" as="geometry" /></mxCell><mxCell id="codec" value="&lt;b&gt;Codec runtime + prepared context&lt;/b&gt;&lt;br&gt;&lt;br&gt;description / prepare / encode / decode&lt;br&gt;Catalogue parsing and field-ID mapping&lt;br&gt;Validation and wire representation&lt;br&gt;Dynamic reading: C, Rust, Python" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=18;fillColor=#e8f0fe;strokeColor=#3971ba;strokeWidth=1.5;fontSize=15;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry x="600" y="510" width="380" height="150" as="geometry" /></mxCell><mxCell id="transport" value="&lt;b&gt;Transport adapter&lt;/b&gt;&lt;br&gt;&lt;br&gt;SDL2 catalogue at connection opening&lt;br&gt;Then message ID + positional values&lt;br&gt;S2PS/2 envelope when selected" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=18;fillColor=#edf0f4;strokeColor=#65758b;strokeWidth=1.5;fontSize=15;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry x="1200" y="510" width="340" height="150" as="geometry" /></mxCell><mxCell id="item14" value="" style="edgeStyle=none;rounded=0;html=0;strokeWidth=2;strokeColor=#60758b;endArrow=block;endFill=1;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="application" target="codec"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="585.0" as="sourcePoint" /><mxPoint x="600" y="585.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="item15" value="values / codec calls" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;text;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#243b53;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="393.0" y="555.0" width="184" height="25" as="geometry" /></mxCell><mxCell id="item16" value="" style="edgeStyle=none;rounded=0;html=0;strokeWidth=2;strokeColor=#60758b;endArrow=block;endFill=1;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="codec" target="transport"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="585.0" as="sourcePoint" /><mxPoint x="1200" y="585.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="item17" value="catalogue / payload" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;text;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#243b53;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1002.0" y="555.0" width="176" height="25" as="geometry" /></mxCell><mxCell id="item18" value="" style="edgeStyle=none;rounded=0;html=0;strokeWidth=2;strokeColor=#60758b;endArrow=open;endFill=0;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="bindings" target="codec"><mxGeometry relative="1" as="geometry"><mxPoint x="1370.0" y="330" as="sourcePoint" /><mxPoint x="790.0" y="510" as="targetPoint" /><Array as="points"><mxPoint x="1370" y="420" /><mxPoint x="790" y="420" /></Array></mxGeometry></mxCell><mxCell id="item19" value="local metadata" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;text;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#243b53;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1012.0" y="390.0" width="136" height="25" as="geometry" /></mxCell><mxCell id="filter" value="&lt;b&gt;Filter service&lt;/b&gt;&lt;br&gt;&lt;br&gt;Prepared catalogue-bound predicates&lt;br&gt;Object or targeted wire evaluation&lt;br&gt;Status returned to application" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=18;fillColor=#e6f4ed;strokeColor=#378165;strokeWidth=1.5;fontSize=15;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry x="60" y="870" width="310" height="145" as="geometry" /></mxCell><mxCell id="record" value="&lt;b&gt;Recording service&lt;/b&gt;&lt;br&gt;&lt;br&gt;Store raw payloads and catalogues&lt;br&gt;Inspect, validate, convert and replay&lt;br&gt;MCAP / SDL USER0 PCAPNG" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=18;fillColor=#e6f4ed;strokeColor=#378165;strokeWidth=1.5;fontSize=16;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry x="600" y="870" width="380" height="145" as="geometry" /></mxCell><mxCell id="inspect" value="&lt;b&gt;Wireshark integration&lt;/b&gt;&lt;br&gt;&lt;br&gt;Native C dissector&lt;br&gt;UDP flow catalogue cache&lt;br&gt;SDL USER0 recording inspection" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=18;fillColor=#e6f4ed;strokeColor=#378165;strokeWidth=1.5;fontSize=16;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry x="1200" y="870" width="340" height="145" as="geometry" /></mxCell><mxCell id="item23" value="" style="edgeStyle=none;rounded=0;html=0;strokeWidth=2;strokeColor=#60758b;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="codec" target="filter"><mxGeometry relative="1" as="geometry"><mxPoint x="790.0" y="660" as="sourcePoint" /><mxPoint x="215.0" y="870" as="targetPoint" /><Array as="points"><mxPoint x="790" y="780" /><mxPoint x="215" y="780" /></Array></mxGeometry></mxCell><mxCell id="item24" value="catalogue + values / bytes" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;text;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#243b53;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="386.5" y="750.0" width="232" height="25" as="geometry" /></mxCell><mxCell id="item25" value="" style="edgeStyle=none;rounded=0;html=0;strokeWidth=2;strokeColor=#60758b;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="codec" target="record"><mxGeometry relative="1" as="geometry"><mxPoint x="790.0" y="660" as="sourcePoint" /><mxPoint x="790.0" y="870" as="targetPoint" /></mxGeometry></mxCell><mxCell id="item26" value="catalogue + raw bytes" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;text;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#243b53;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="694.0" y="735.0" width="192" height="25" as="geometry" /></mxCell><mxCell id="item27" value="" style="edgeStyle=none;rounded=0;html=0;strokeWidth=2;strokeColor=#60758b;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="transport" target="inspect"><mxGeometry relative="1" as="geometry"><mxPoint x="1370.0" y="660" as="sourcePoint" /><mxPoint x="1370.0" y="870" as="targetPoint" /></mxGeometry></mxCell><mxCell id="item28" value="capture" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;text;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#243b53;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1320.0" y="735.0" width="100" height="25" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="02-implementations" name="02 Codecs and service implementations"><mxGraphModel dx="1600" dy="1260" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1260" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="item0" value="SDL DESIGN / STATIC / 02" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#64748b;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1520" height="25" as="geometry" /></mxCell><mxCell id="item1" value="Codecs and service implementations" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=30;fontColor=#16324f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1520" height="50" as="geometry" /></mxCell><mxCell id="item2" value="Implementation boundaries and language gateways; columns are independent API families." style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=16;fontColor=#526578;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="116" width="1520" height="40" as="geometry" /></mxCell><mxCell id="footer" value="&lt;b&gt;Design notes&lt;/b&gt;&lt;br&gt;&lt;br&gt;Applications call both their codec and the required services. A JNI or MEX service gateway does not replace the Java or MATLAB codec.&lt;br&gt;Recording passes existing encoded bytes to its engine; it needs no generated Rust message bindings. Python recording is a separate implementation." style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=18;fillColor=#fff9e9;strokeColor=#d1bb7e;strokeWidth=1.5;fontSize=15;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="1520" height="130" as="geometry" /></mxCell><mxCell id="item4" value="CODEC BACKENDS" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=18;fontColor=#243b53;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="185" width="440" height="35" as="geometry" /></mxCell><mxCell id="item5" value="FILTER ENGINE" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=18;fontColor=#243b53;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="570" y="185" width="460" height="35" as="geometry" /></mxCell><mxCell id="item6" value="RECORDING ENGINES" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=18;fontColor=#243b53;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1100" y="185" width="440" height="35" as="geometry" /></mxCell><mxCell id="c" value="&lt;b&gt;C99&lt;/b&gt;&lt;br&gt;&lt;br&gt;Descriptors + registry&lt;br&gt;Typed / dynamic codecs" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=18;fillColor=#e8f0fe;strokeColor=#3971ba;strokeWidth=1.5;fontSize=16;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="440" height="90" as="geometry" /></mxCell><mxCell id="rust" value="&lt;b&gt;Rust&lt;/b&gt;&lt;br&gt;&lt;br&gt;SdlMessage + TypeInfo&lt;br&gt;Typed / dynamic codecs" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=18;fillColor=#e8f0fe;strokeColor=#3971ba;strokeWidth=1.5;fontSize=16;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry x="60" y="365" width="440" height="90" as="geometry" /></mxCell><mxCell id="python" value="&lt;b&gt;Python&lt;/b&gt;&lt;br&gt;&lt;br&gt;Classes + runtime&lt;br&gt;Typed / dynamic; native packed buffers" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=18;fillColor=#e8f0fe;strokeColor=#3971ba;strokeWidth=1.5;fontSize=16;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="440" height="90" as="geometry" /></mxCell><mxCell id="java" value="&lt;b&gt;Java&lt;/b&gt;&lt;br&gt;&lt;br&gt;Generated classes + SdlCodec&lt;br&gt;Java codec; primitive packed arrays" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=18;fillColor=#e8f0fe;strokeColor=#3971ba;strokeWidth=1.5;fontSize=16;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry x="60" y="595" width="440" height="90" as="geometry" /></mxCell><mxCell id="ada" value="&lt;b&gt;Ada&lt;/b&gt;&lt;br&gt;&lt;br&gt;Generated direct codecs&lt;br&gt;C context + dynamic fallback" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=18;fillColor=#e8f0fe;strokeColor=#3971ba;strokeWidth=1.5;fontSize=16;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry x="60" y="710" width="440" height="90" as="geometry" /></mxCell><mxCell id="matlab" value="&lt;b&gt;MATLAB / Octave&lt;/b&gt;&lt;br&gt;&lt;br&gt;Generated functions + MATLAB runtime&lt;br&gt;Fixed codecs; selected example MEX paths" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=18;fillColor=#e8f0fe;strokeColor=#3971ba;strokeWidth=1.5;fontSize=16;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry x="60" y="825" width="440" height="90" as="geometry" /></mxCell><mxCell id="fcore" value="&lt;b&gt;Rust predicate engine&lt;/b&gt;&lt;br&gt;&lt;br&gt;runtime/rust/src/filter&lt;br&gt;Prepared expressions; object / wire readers&lt;br&gt;Direct API for Rust applications" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=18;fillColor=#e6f4ed;strokeColor=#378165;strokeWidth=1.5;fontSize=16;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry x="570" y="250" width="460" height="115" as="geometry" /></mxCell><mxCell id="fabi" value="&lt;b&gt;Filter C ABI&lt;/b&gt;&lt;br&gt;&lt;br&gt;runtime/filter/src/lib.rs&lt;br&gt;libsdl_filter: opaque predicate handles" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=18;fillColor=#e6f4ed;strokeColor=#378165;strokeWidth=1.5;fontSize=16;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry x="570" y="430" width="460" height="90" as="geometry" /></mxCell><mxCell id="fadapters" value="&lt;b&gt;Language adapters&lt;/b&gt;&lt;br&gt;&lt;br&gt;C native reader / CPython extension&lt;br&gt;Java JNI / Ada bindings / MATLAB MEX&lt;br&gt;Translate local values and diagnostics" style="html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;rounded=1;arcSize=8;align=left;verticalAlign=t