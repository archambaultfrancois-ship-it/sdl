/* Draft notes: message Ignored { string unused; } */
/** Geometry catalogue. */
package navigation.geometry;
/** State of a point. */
enum State { ZERO = 0; /** Inactive. */ ONE = 1; /** Active. */ }
/** Point coordinates. Quotes "x"; escaped text \u002a\u002f. */
message Point { int32 x; /** Position along the axis. */ State state; }
/** Sample containing global, local and foreign points. */
message Sample {
   Point local; /** Local point. */
   .Point global_point;
   radio.Point remote;
   State state;
   .State global_state;
   radio.State remote_state;
   /** Fixed array of local points. */
   Point [ POINT_COUNT ] points;
   packed radio.Point remote_points;
   optional struct {
      State state; int32 code; /** Diagnostic code. */
   } detail; /** Optional diagnostic. */
}
const POINT_COUNT = 2; /** Number of points in the fixed array. */
