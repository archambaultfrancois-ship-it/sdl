/* Draft notes: message Ignored { string unused; } */
/** Geometry catalogue. */
package navigation.geometry;
/** State of a point. */
enum State { ZERO = 0; /** Inactive. */ ONE = 1; /** Active. */ }
/** Point coordinates. Quotes "x"; escaped text \u002a\u002f. */
message Point { int32 x; /** Position along the axis. */ State state; }
alias LocalPoint = Point;
alias GlobalPoint = .GlobalPosition;
alias RemotePoint = radio.Position;
alias Status = State;
alias Diagnostic = .Coordinate;
/** Sample containing global, local and foreign points. */
message Sample {
   LocalPoint local; /** Local point. */
   GlobalPoint global_point;
   RemotePoint remote;
   Status state;
   .State global_state;
   radio.State remote_state;
   /** Fixed array of local points. */
   LocalPoint [ POINT_COUNT ] points;
   packed RemotePoint remote_points;
   optional struct {
      Status state; Diagnostic code; /** Diagnostic code. */
   } detail; /** Optional diagnostic. */
}
const POINT_COUNT = (radio.POINT_COUNT + .BASE_POINT_COUNT) * 2 / 2; /** Number of points in the fixed array. */
